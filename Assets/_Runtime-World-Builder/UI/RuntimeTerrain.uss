/* Runtime World Builder - Studio UI */

.rwb-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    padding: 14px;
    font-size: 12px;
    color: #E8EDF5;
}

.hidden { display: none; }

/* ---------- TEXT: force readable colours (theme overrides inheritance) ---------- */
.rwb-root .unity-label,
.rwb-root .unity-text-element,
.rwb-root .unity-button,
.rwb-root .unity-base-field__label,
.rwb-root .unity-toggle__text {
    color: #E8EDF5;
}

.rwb-root .unity-label { white-space: normal; }

/* ---------- ICONS ---------- */
.btn-icon  { width: 14px; height: 14px; margin-right: 6px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: #E8EDF5; }
.rail-icon { width: 16px; height: 16px; margin-right: 8px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: #E8EDF5; }

.btn-lbl, .rail-lbl { margin: 0; padding: 0; color: inherit; -unity-font-style: bold; }

.icon-undo     { background-image: url("Icons/icon-undo.svg"); }
.icon-redo     { background-image: url("Icons/icon-redo.svg"); }
.icon-save     { background-image: url("Icons/icon-save.svg"); }
.icon-load     { background-image: url("Icons/icon-load.svg"); }
.icon-play     { background-image: url("Icons/icon-play.svg"); }
.icon-layers   { background-image: url("Icons/icon-layers.svg"); }
.icon-sculpt   { background-image: url("Icons/icon-sculpt.svg"); }
.icon-stamps   { background-image: url("Icons/icon-stamps.svg"); }
.icon-roads    { background-image: url("Icons/icon-roads.svg"); }
.icon-paint    { background-image: url("Icons/icon-paint.svg"); }
.icon-nature   { background-image: url("Icons/icon-nature.svg"); }
.icon-library  { background-image: url("Icons/icon-library.svg"); }
.icon-settings { background-image: url("Icons/icon-settings.svg"); }
.icon-raise    { background-image: url("Icons/icon-raise.svg"); }
.icon-lower    { background-image: url("Icons/icon-lower.svg"); }
.icon-smooth   { background-image: url("Icons/icon-smooth.svg"); }
.icon-flatten  { background-image: url("Icons/icon-flatten.svg"); }
.icon-river    { background-image: url("Icons/icon-river.svg"); }
.icon-grass    { background-image: url("Icons/icon-grass.svg"); }
.icon-rock     { background-image: url("Icons/icon-rock.svg"); }
.icon-building { background-image: url("Icons/icon-building.svg"); }

/* ---------- TOP BAR ---------- */
.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.pill-panel {
    flex-direction: row;
    align-items: center;
    background-color: rgba(17, 22, 30, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: 6px 10px;
}

.brand-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: #FFFFFF;
    margin: 0 10px 0 4px;
}

.active-badge {
    background-color: rgba(59, 130, 246, 0.25);
    border-width: 1px;
    border-color: #3B82F6;
    border-radius: 6px;
    padding: 2px 10px;
    font-size: 11px;
    color: #BFDBFE;
}

.top-btn {
    height: 28px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.07);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    border-radius: 7px;
    padding: 0 12px;
    margin: 0 3px;
    font-size: 12px;
    -unity-font-style: bold;
}

.top-btn:hover { background-color: rgba(255, 255, 255, 0.16); }
.top-btn:active { background-color: rgba(255, 255, 255, 0.24); }
.top-btn:disabled { opacity: 0.4; }

.top-btn--accent { background-color: #2563EB; border-color: #60A5FA; }
.top-btn--accent:hover { background-color: #3B82F6; }
.top-btn--accent .btn-lbl, .top-btn--accent .unity-text-element { color: #FFFFFF; }

/* ---------- WORKSPACE ---------- */
.workspace-area {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.left-cluster { flex-direction: row; align-items: flex-start; }

/* ---------- LEFT RAIL ---------- */
.tool-rail {
    width: 124px;
    background-color: rgba(17, 22, 30, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: 6px;
    margin-right: 10px;
}

.rail-btn {
    height: 34px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: transparent;
    border-width: 1px;
    border-color: transparent;
    border-radius: 8px;
    padding-left: 10px;
    margin: 0 0 3px 0;
    font-size: 12px;
    -unity-font-style: bold;
}

.rail-btn:hover { background-color: rgba(255, 255, 255, 0.10); }

.rail-btn--active { background-color: #2563EB; border-color: #60A5FA; }
.rail-btn--active .rail-lbl, .rail-btn--active .unity-text-element { color: #FFFFFF; }

/* ---------- POPOVER ---------- */
.tool-popover {
    width: 310px;
    max-height: 560px;
    background-color: rgba(17, 22, 30, 0.95);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 12px;
    padding: 12px;
}

.popover-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.12);
}

.popover-title { font-size: 14px; -unity-font-style: bold; color: #FFFFFF; }

.popover-scroll { flex-shrink: 1; flex-grow: 0; max-height: 480px; }
.popover-body { flex-direction: column; padding-right: 6px; }

.sub-header {
    font-size: 11px;
    -unity-font-style: bold;
    color: #93A4BC;
    letter-spacing: 0.6px;
    margin-top: 12px;
    margin-bottom: 6px;
}

.rwb-root .sub-header { color: #93A4BC; }

.section-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.12);
    margin: 12px 0 2px 0;
}

/* ---------- FIELDS ---------- */
.field { margin-bottom: 6px; }

.field > .unity-base-field__label {
    min-width: 96px;
    width: 96px;
    font-size: 11px;
    color: #CBD5E1;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* text / number inputs */
.rwb-root .unity-base-text-field__input,
.rwb-root .unity-base-popup-field__input {
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 6px;
    color: #FFFFFF;
    padding: 2px 6px;
    min-height: 22px;
}

.rwb-root .unity-base-text-field__input:focus {
    border-color: #60A5FA;
    background-color: rgba(255, 255, 255, 0.12);
}

.rwb-root .unity-base-text-field__input .unity-text-element,
.rwb-root .unity-base-popup-field__text,
.rwb-root .unity-base-popup-field__input .unity-text-element {
    color: #FFFFFF;
}

.rwb-root .unity-base-popup-field__arrow { -unity-background-image-tint-color: #CBD5E1; }

/* slider */
.rwb-root .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.18);
    border-width: 0;
    border-radius: 3px;
    height: 4px;
}

.rwb-root .unity-base-slider__dragger {
    background-color: #60A5FA;
    border-color: #FFFFFF;
    border-width: 1px;
    border-radius: 8px;
    width: 14px;
    height: 14px;
}

.rwb-root .unity-slider__input { margin-right: 6px; }
.rwb-root .unity-slider .unity-base-text-field__input { min-width: 44px; }

/* toggle */
.rwb-root .unity-toggle__input { margin-left: 0; }

.rwb-root .unity-toggle__checkmark {
    -unity-background-image-tint-color: #FFFFFF;
}

.rwb-root .unity-toggle__input > .unity-base-toggle__checkmark,
.rwb-root .unity-toggle__checkmark {
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.28);
    border-radius: 4px;
    width: 16px;
    height: 16px;
}

.rwb-root .unity-toggle__input:checked > .unity-toggle__checkmark {
    background-color: #2563EB;
    border-color: #60A5FA;
}

/* selected heightmap label (between the < > buttons) */
.selected-label {
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: middle-center;
    font-size: 11px;
    color: #BFDBFE;
    margin: 4px 4px 0 4px;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ---------- BUTTONS ---------- */
.icon-btn {
    width: 24px;
    height: 24px;
    background-color: rgba(255, 255, 255, 0.09);
    border-width: 0;
    border-radius: 6px;
    padding: 0;
    font-size: 12px;
}

.icon-btn:hover { background-color: rgba(255, 255, 255, 0.20); }

.chip-grid-3, .chip-grid-2 {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 8px;
}

.chip-grid-3 > .tool-chip, .chip-grid-2 > .tool-chip { width: 48%; }

.tool-chip {
    height: 30px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 7px;
    font-size: 12px;
    -unity-font-style: bold;
    margin: 0 0 5px 0;
}

.tool-chip:hover { background-color: rgba(255, 255, 255, 0.16); }

.tool-chip--active { background-color: rgba(59, 130, 246, 0.30); border-color: #60A5FA; }
.tool-chip--active .btn-lbl, .tool-chip--active .unity-text-element { color: #FFFFFF; }

.action-btn {
    min-height: 30px;
    height: auto;
    border-radius: 7px;
    border-width: 1px;
    font-size: 12px;
    -unity-font-style: bold;
    margin: 6px 0 0 0;
    padding: 4px 10px;
    white-space: normal;       /* long labels wrap instead of being cut off */
}

.action-btn:hover { opacity: 0.88; }
.action-btn:active { opacity: 0.7; }

.action-btn--primary { background-color: #2563EB; border-color: #60A5FA; }
.action-btn--primary, .action-btn--primary .unity-text-element,
.action-btn--green,   .action-btn--green .unity-text-element { color: #FFFFFF; }

.action-btn--green  { background-color: #16A34A; border-color: #4ADE80; }
.action-btn--soft   { background-color: rgba(255, 255, 255, 0.09); border-color: rgba(255, 255, 255, 0.16); }
.action-btn--danger { background-color: rgba(220, 38, 38, 0.25); border-color: #EF4444; }
.action-btn--danger, .action-btn--danger .unity-text-element { color: #FECACA; }

.btn-row { flex-direction: row; align-items: center; margin-top: 2px; }
.btn--grow { flex-grow: 1; margin-right: 4px; }

.status-hint {
    font-size: 11px;
    color: #93C5FD;
    margin-top: 4px;
    white-space: normal;
}

.rwb-root .status-hint { color: #93C5FD; }

/* ---------- MINIMAP & LAYERS ---------- */
.right-cluster { align-items: flex-end; }

.minimap-card {
    width: 168px;
    background-color: rgba(17, 22, 30, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 12px;
    padding: 6px;
    margin-bottom: 8px;
}

.minimap-viewport {
    height: 100px;
    background-color: #0B0F15;
    border-radius: 8px;
    justify-content: flex-end;
    padding: 4px;
}

.minimap-badge {
    font-size: 10px;
    background-color: rgba(0, 0, 0, 0.65);
    border-radius: 4px;
    padding: 2px 6px;
    align-self: flex-start;
}

.minimap-controls { flex-direction: row; justify-content: space-between; margin-top: 5px; }

.map-btn {
    flex-grow: 1;
    height: 24px;
    background-color: rgba(255, 255, 255, 0.09);
    border-width: 0;
    border-radius: 5px;
    margin: 0 2px;
    padding: 0;
    font-size: 12px;
    -unity-font-style: bold;
}

.map-btn:hover { background-color: rgba(255, 255, 255, 0.20); }

.layers-pill-btn {
    height: 30px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(17, 22, 30, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 9px;
    padding: 0 12px;
    margin: 0 0 8px 0;
    font-size: 12px;
    -unity-font-style: bold;
}

.layers-pill-btn:hover { background-color: rgba(255, 255, 255, 0.12); }

.layers-popover {
    width: 180px;
    background-color: rgba(17, 22, 30, 0.95);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 12px;
    padding: 8px 12px;
}

/* ---------- MODAL ---------- */
.modal-backdrop {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.modal-card {
    width: 480px;
    background-color: rgba(22, 28, 38, 0.98);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.20);
    border-radius: 14px;
    padding: 16px;
}

.modal-header { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 14px; }
.modal-title { font-size: 16px; -unity-font-style: bold; color: #FFFFFF; }
.modal-body { flex-direction: row; justify-content: space-between; margin-bottom: 14px; }
.modal-form { flex-grow: 1; margin-right: 14px; }
.browse-row { flex-direction: row; align-items: center; }
.browse-field { flex-grow: 1; margin-right: 6px; }

.modal-preview-box {
    width: 112px;
    height: 112px;
    background-color: #0B0F15;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    align-items: center;
    justify-content: center;
}

.preview-caption { font-size: 11px; color: #7C8AA0; }
.rwb-root .preview-caption { color: #7C8AA0; }

.modal-footer { flex-direction: row; justify-content: flex-end; }
.modal-footer > .action-btn { margin-left: 8px; min-width: 90px; }

/* ---------- BOTTOM LIBRARY ---------- */
.bottom-dock-wrap { align-items: center; margin-top: 10px; }

.asset-library-bar {
    width: 900px;
    max-width: 96%;
    background-color: rgba(17, 22, 30, 0.94);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 14px;
    padding: 10px 14px;
}

.library-header { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 8px; }
.library-title { font-size: 11px; -unity-font-style: bold; letter-spacing: 1px; color: #93A4BC; }
.rwb-root .library-title { color: #93A4BC; }

.library-tabs-row { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.library-tabs { flex-direction: row; flex-wrap: wrap; }

.lib-tab {
    height: 26px;
    background-color: rgba(255, 255, 255, 0.07);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    border-radius: 7px;
    padding: 0 12px;
    margin: 0 4px 0 0;
    font-size: 12px;
    -unity-font-style: bold;
}

.lib-tab:hover { background-color: rgba(255, 255, 255, 0.16); }
.lib-tab--active { background-color: #2563EB; border-color: #60A5FA; }
.lib-tab--active, .lib-tab--active .unity-text-element { color: #FFFFFF; }

.add-lib-btn {
    height: 26px;
    background-color: rgba(59, 130, 246, 0.25);
    border-width: 1px;
    border-color: #3B82F6;
    border-radius: 7px;
    padding: 0 12px;
    margin: 0;
    font-size: 12px;
    -unity-font-style: bold;
}

.add-lib-btn, .add-lib-btn .unity-text-element { color: #BFDBFE; }
.add-lib-btn:hover { background-color: #2563EB; }
.add-lib-btn:hover, .add-lib-btn:hover .unity-text-element { color: #FFFFFF; }

.library-cards-scroll { height: 92px; }
.library-cards-container { flex-direction: row; align-items: center; }

.asset-card {
    width: 88px;
    height: 82px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 9px;
    margin-right: 8px;
    padding: 6px;
    align-items: center;
    justify-content: space-between;
}

.asset-card:hover { background-color: rgba(255, 255, 255, 0.14); }
.asset-card--selected { background-color: rgba(37, 99, 235, 0.30); border-color: #60A5FA; }

.asset-card__thumb { width: 46px; height: 46px; background-color: rgba(0, 0, 0, 0.35); border-radius: 6px; }

.asset-card__label {
    font-size: 10px;
    color: #E8EDF5;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* ---------- DROPDOWN MENU (lives outside .rwb-root, needs the stylesheet on the panel) ---------- */
.unity-base-dropdown__container-outer {
    background-color: #1B222D;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.22);
    border-radius: 8px;
    padding: 4px;
}

.unity-base-dropdown__container-inner { background-color: transparent; }

.unity-base-dropdown__item {
    min-height: 26px;
    border-radius: 5px;
    padding: 0 8px;
    color: #E8EDF5;
}

.unity-base-dropdown__item:hover { background-color: rgba(59, 130, 246, 0.35); }

.unity-base-dropdown__label,
.unity-base-dropdown__item .unity-label,
.unity-base-dropdown__item .unity-text-element {
    color: #E8EDF5;
    font-size: 12px;
}

/* ---------- FIXED FIELD / SLIDER LAYOUT ---------- */
.rwb-root .field {
    width: 100%;
    min-width: 0;
    margin-bottom: 9px;
}
.rwb-root .field > .unity-base-field__label {
    width: 88px;
    min-width: 88px;
    max-width: 88px;
    flex-shrink: 0;
    margin-right: 8px;
}
.rwb-root .unity-slider {
    width: 100%;
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
}
.rwb-root .unity-slider__input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 40px;
    margin-right: 8px;
}
.rwb-root .unity-base-slider {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 50px;
    height: 22px;
    margin: 0;
}
.rwb-root .unity-base-slider__drag-container {
    height: 18px;
    top: 2px;
}
.rwb-root .unity-base-slider__tracker {
    height: 4px;
    margin-top: 7px;
    border-radius: 3px;
}
.rwb-root .unity-base-slider__dragger {
    width: 14px;
    height: 14px;
    min-width: 14px;
    min-height: 14px;
    margin-top: 2px;
    border-radius: 50%;
}
.rwb-root .unity-slider .unity-base-text-field__input {
    width: 48px;
    min-width: 48px;
    max-width: 48px;
    height: 24px;
    min-height: 24px;
    margin-left: 4px;
}
.rwb-root .unity-base-field__input {
    min-width: 0;
}

/* Native file picker row */
.file-picker-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 6px;
}
.file-picker-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 30px;
    padding: 7px 8px;
    margin-right: 6px;
    background-color: rgba(255,255,255,0.07);
    border-width: 1px;
    border-color: rgba(255,255,255,0.14);
    border-radius: 6px;
    color: #CBD5E1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.file-picker-row .action-btn { min-width: 82px; margin-top: 0; }

/* Make the visible panels deliberate pointer targets; transparent canvas stays pass-through. */
.tool-rail, .tool-popover, .minimap-card, .layers-popover,
.layers-pill-btn, .asset-library-bar, .modal-backdrop,
.pill-panel, .top-btn, .rail-btn, .tool-chip, .action-btn,
.lib-tab, .add-lib-btn, .icon-btn, .map-btn {
    /* Keep their normal picking mode (Position); do not set Ignore here. */
}
